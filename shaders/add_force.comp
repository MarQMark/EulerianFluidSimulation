#version 430
layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) buffer          BufVel      { vec2  vel[];      };
layout(std430, binding = 1) readonly buffer BufRho      { float rho[];      };
layout(std430, binding = 2) readonly buffer BufForces   { vec2  forces[];   };
layout(std430, binding = 3) readonly buffer BufBoundary { float boundary[]; };

uniform int   uWidth;
uniform int   uHeight;
uniform float uDt;
uniform float uGravity;

int idx(int x, int y) { return y * uWidth + x; }

void main() {
    int x = int(gl_GlobalInvocationID.x) + 1;
    int y = int(gl_GlobalInvocationID.y) + 1;
    if (x >= uWidth - 1 || y >= uHeight - 1) return;

    const int i = idx(x, y);
    const float valid = (1.0 - boundary[i]) * step(0.5, rho[i]);
    vel[i] += valid * (forces[i] - vec2(0, uGravity)) * uDt;
}