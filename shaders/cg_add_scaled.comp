#version 430
layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) buffer           BufResult   { float result[];   };
layout(std430, binding = 1) readonly  buffer BufX        { float xField[];   };

uniform int uCount;
uniform float uFactor;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= uCount)
        return;

    result[i] += uFactor * xField[i];
}