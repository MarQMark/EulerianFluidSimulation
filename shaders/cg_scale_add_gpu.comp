#version 430
layout(local_size_x = 256) in;

// result[i] = result[i] * scalars[uScalarIdx] + x[i]
//
// Replaces the CPU-uniform version (cg_scale_add.comp) for the inner loop.
// Reads beta directly from the GPU scalar state buffer.
layout(std430, binding = 0) buffer          BufResult { float result[];  };
layout(std430, binding = 1) readonly buffer BufX      { float xField[];  };
layout(std430, binding = 2) readonly buffer CgScalars { float scalars[]; };

uniform int uCount;
uniform int uScalarIdx;   // 3 = beta

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(uCount)) return;
    result[i] = result[i] * scalars[uScalarIdx] + xField[i];
}
