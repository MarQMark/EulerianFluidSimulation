#version 430
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

struct Triangle {
    vec3 v0;
    vec3 v1;
    vec3 v2;
};

layout(std430, binding = 0)          buffer BufData      { float data[];         };

uniform vec3  uDomainSize;
uniform vec3  uDomainCenter;

uniform int   uWidth;
uniform int   uHeight;
uniform int   uDepth;

uniform int   uFillHeight;

int idx(int x, int y, int z) { return z * uWidth * uHeight + y * uWidth + x; }

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    int z = int(gl_GlobalInvocationID.z);

    if (x == 0 || x >= uWidth - 1 || y == 0 || y >= uHeight - 1 || z == 0 ||  z >= uDepth - 1 || y >= uFillHeight)
        return;

    const int id = idx(x, y, z);
    data[id] = 1.0f;
}
