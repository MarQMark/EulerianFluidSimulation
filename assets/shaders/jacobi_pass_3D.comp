#version 430
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(std430, binding = 0) writeonly buffer BufResult   { float result[];   };
layout(std430, binding = 1) readonly  buffer BufP        { float p[];        };
layout(std430, binding = 2) readonly  buffer BufB        { float b[];        };
layout(std430, binding = 3) readonly  buffer BufRho      { float rho[];      };
layout(std430, binding = 4) readonly  buffer BufBoundary { float boundary[]; };

uniform int uWidth;
uniform int uHeight;
uniform int uDepth;

int idx(int x, int y, int z) {
    return z * uWidth * uHeight + y * uWidth + x;
}

void sampleNeighbor(int nx, int ny, int nz, inout float sum, inout int nCount) {
    if (nx < 0 || nx >= uWidth || ny < 0 || ny >= uHeight || nz < 0 || nz >= uDepth)
        return;
    if (nx == 0 || nx == uWidth-1 || ny == 0 || ny == uHeight-1 || nz == 0 || nz == uDepth-1)
        return;
    if (boundary[idx(nx, ny, nz)] > 0.5)
        return;

    nCount++;
    if (rho[idx(nx, ny, nz)] > 0.5){
        sum += p[idx(nx, ny, nz)];
    }
}

// x1 = D^-1 (b - (L + U) x0)
void main(){
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    int z = int(gl_GlobalInvocationID.z);

    if (x >= uWidth || y >= uHeight || z >= uDepth)
        return;

    const int i = idx(x, y, z);
    if (rho[i] <= 0.5 || boundary[i] > .5) {
        result[i] = p[i];
        return;
    }

    float sum = 0.0;
    int nCount = 0;

    sampleNeighbor(x - 1, y, z, sum, nCount);
    sampleNeighbor(x + 1, y, z, sum, nCount);
    sampleNeighbor(x, y - 1, z, sum, nCount);
    sampleNeighbor(x, y + 1, z, sum, nCount);
    sampleNeighbor(x, y, z - 1, sum, nCount);
    sampleNeighbor(x, y, z + 1, sum, nCount);

    if(nCount == 0)
        result[i] = 0.0;
    else
        result[i] = (sum - b[i]) / float(nCount);
}