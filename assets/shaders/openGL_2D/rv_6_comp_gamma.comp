#version 430
layout(local_size_x = 16, local_size_y = 16) in;

struct AdvCell { uint j; float val; };

layout(std430, binding = 0) writeonly buffer BufGamma    { float   gamma[];    };
layout(std430, binding = 1) readonly  buffer BufA        { AdvCell A[];        };
layout(std430, binding = 2) readonly  buffer BufCount    { uint    counts[];   };

uniform int uWidth;
uniform int uHeight;

int idx(int x, int y) { return y * uWidth + x; }

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (x >= uWidth || y >= uHeight) return;

    const int i = idx(x, y);
    float s = 0.0;
    uint base = i * 8;
    for (uint k = 0u; k < counts[i]; k++)
    s += A[base + k].val;

    gamma[i] = s;
}

