#version 430
layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0)          buffer BufVel      { vec2  vel[];      };
layout(std430, binding = 1) readonly buffer BufPres     { float pres[];     };
layout(std430, binding = 2) readonly buffer BufBoundary { float boundary[]; };

uniform int   uWidth;
uniform int   uHeight;

int idx(int x, int y) { return y * uWidth + x; }

void main() {
    int x = int(gl_GlobalInvocationID.x) + 1;
    int y = int(gl_GlobalInvocationID.y) + 1;
    if (x >= uWidth - 1 || y >= uHeight - 1) return;

    const int i = idx(x, y);
    if(boundary[i] == 1) return;

    vec2 dPressure = vec2(0);
    if (x != 1)
        dPressure.x = pres[i] - pres[idx(x - 1, y)];
    if (y != 1)
        dPressure.y = pres[i] - pres[idx(x, y - 1)];

    vel[i] -= dPressure;
}