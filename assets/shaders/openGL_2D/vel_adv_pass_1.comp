#version 430
layout(local_size_x = 16, local_size_y = 16) in;

struct AdvCell { uint j; float val; };

layout(std430, binding = 0)            buffer BufVel        { vec2    vel[];        };
layout(std430, binding = 1)            buffer BufVelTmp     { vec2    tmpVel[];     };
layout(std430, binding = 2)            buffer BufRho        { float   rho[];        };
layout(std430, binding = 3)            buffer BufRhoTmp     { float   tmpRho[];     };
layout(std430, binding = 4)            buffer BufGamma      { float   gamma[];      };
layout(std430, binding = 5)            buffer BufNewGamma   { float   newGamma[];   };
layout(std430, binding = 6)            buffer BufBeta       { float   beta[];       };
layout(std430, binding = 7)            buffer BufABwd       { AdvCell ABwd[];       };
layout(std430, binding = 8)            buffer BufAFwd       { AdvCell AFwd[];       };
layout(std430, binding = 9)            buffer BufCountsBwd  { uint    countsBwd[];  };
layout(std430, binding = 10)           buffer BufCountsFwd  { uint    countsFwd[];  };
layout(std430, binding = 11) writeonly buffer BufDivergence { float   divergence[]; };
layout(std430, binding = 12) readonly  buffer BufPressure   { float   pressure[];   };
layout(std430, binding = 13) readonly  buffer BufForces     { vec2    forces[];     };
layout(std430, binding = 14) readonly  buffer BufBoundary   { float   boundary[];   };

uniform uint uWidth;
uniform uint uHeight;
uint idx(uint x, uint y) { return y * uWidth + x; }

uniform float uDt;
uniform int   uSubsteps;

float bnd (uint x, uint y) { return boundary[idx(x, y)]; }

bool inWall(vec2 p) {
    if (p.x < 1.0 || p.x > float(uWidth)  - 2.0 ||
        p.y < 1.0 || p.y > float(uHeight) - 2.0)
    return true;

    return bnd(clamp(uint(p.x), 0u, uWidth -1u),
               clamp(uint(p.y), 0u, uHeight-1u)) > 0.5;
}

vec2 domainClamp(vec2 p) {
    return clamp(p, vec2(1.0), vec2(float(uWidth) - 2.0, float(uHeight) - 2.0));
}

float BilinearInterpolation(const vec2 pos, int low_x, int low_y, int comp) {
    float x_low_inter, x_high_inter;

    // Interpolate between y values at the lower x positions
    x_low_inter = (((low_y + 0.5 * (1 - comp)) - pos[1])
    * vel[idx(low_x, low_y)][comp])
    + ((pos[1] - (low_y - 0.5 - 0.5 * comp))
    * vel[idx(low_x, low_y + 1)][comp]);
    // Interpolate between y values at the higher x positions
    x_high_inter = (((low_y + 0.5 * (1 - comp)) - pos[1])
    * vel[idx(low_x + 1, low_y)][comp])
    + ((pos[1] - (low_y - 0.5 - 0.5 * comp))
    * vel[idx(low_x + 1, low_y + 1)][comp]);

    // Interpolate between the averaged values at the low and high x positions
    return ((low_x + 0.5 * comp - pos[0]) * x_low_inter)
    + ((pos[0] - (low_x - 0.5 - 0.5 * (1 - comp))) * x_high_inter);
}

#define EPSILON 1.0e-10
vec2 sampleVel(vec2 pos) {
    float Vx, Vy;

    // Interpolate the x component
    int low_x = int(floor(pos[0] + 1) + EPSILON);
    int low_y = int(pos[1] + 0.5 + EPSILON);
    Vx = BilinearInterpolation(pos, low_x, low_y, 0);

    // Interpolate the y component
    low_x = int(pos[0] + 0.5);
    low_y = int(floor(pos[1] + 1) + EPSILON);
    Vy = BilinearInterpolation(pos, low_x, low_y, 1);

    return vec2(Vx, Vy);
}

vec2 traceParticle(vec2 start) {
    if (inWall(start)) return start;

    float subDt = -uDt / float(uSubsteps);   // backward
    vec2  pos   = start;

    for (int s = 0; s < uSubsteps; s++) {
        vec2 k1   = sampleVel(pos - 0.5);
        vec2 mid  = domainClamp(pos + k1 * (subDt * 0.5));
        vec2 k2   = sampleVel(mid - 0.5);
        vec2 next = pos + k2 * subDt;

        if (inWall(next)) {
            // Binary search: find last safe position before the wall
            vec2 safe = pos;
            vec2 unsafe = next;
            vec2 h = safe;
            for (int b = 0; b < 8; b++) {
                h = (safe + unsafe) * 0.5;
                if (inWall(h)) unsafe = h;
                else              safe   = h;
            }
            return safe;
        }
        pos = next;
    }
    return pos;
}

void main() {
    uint x = int(gl_GlobalInvocationID.x) + 1;
    uint y = int(gl_GlobalInvocationID.y) + 1;
    if (x >= uWidth - 1 || y >= uHeight - 1) return;

    vec2 prevPos      = traceParticle(vec2(x, y));
    tmpVel[idx(x, y)] = sampleVel(prevPos - 0.5);
}

