#version 430
layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly  buffer BufSrcVel   { vec2  srcVel[];   };
layout(std430, binding = 1) readonly  buffer BufSrcValid { float srcValid[]; };
layout(std430, binding = 2)           buffer BufDstVel   { vec2  dstVel[];   };
layout(std430, binding = 3)           buffer BufDstValid { float dstValid[]; };
layout(std430, binding = 4) readonly  buffer BufBoundary { float boundary[]; };

uniform uint uWidth;
uniform uint uHeight;
uint idx(uint x, uint y) { return y * uWidth + x; }

void samp(const uint nx, const uint ny, inout vec2 sum, inout float n) {
    const uint ni = idx(nx, ny);
    if (srcValid[ni] > 0.5f) {
        sum += srcVel[ni];
        n++;
    }
}

void main() {
    uint x = int(gl_GlobalInvocationID.x) + 1;
    uint y = int(gl_GlobalInvocationID.y) + 1;
    if (x >= uWidth - 1 || y >= uHeight - 1) return;

    const  uint i = idx(x, y);

    if (boundary[i] > 0.5) {
        dstVel[i] = srcVel[i];
        dstValid[i] = 0.;
        return;
    }
    if (srcValid[i] > 0.5) {
        dstVel[i] = srcVel[i];
        dstValid[i] = 1.;
        return;
    }

    vec2 sum = vec2(0.);
    float n = 0;

    samp(x-1, y, sum, n);
    samp(x+1, y, sum, n);
    samp(x, y-1, sum, n);
    samp(x, y+1, sum, n);

    if(n > 0){
        dstVel[i] = sum / n;
        dstValid[i] = 1.;
    }
    else{
        dstVel[i] = srcVel[i];
        dstValid[i] = 0.;
    }
}

