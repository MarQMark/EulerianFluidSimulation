#version 430
layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) buffer          BufVel     { vec2  vel[];      };
layout(std430, binding = 1) readonly buffer BufNewVel  { vec2  newVel[];   };
layout(std430, binding = 2) readonly buffer BufBoundary{ float boundary[]; };

uniform int uWidth;
uniform int uHeight;

int  idx (int x, int y) { return y * uWidth + x; }

void main() {
    int x = int(gl_GlobalInvocationID.x) + 1;
    int y = int(gl_GlobalInvocationID.y) + 1;
    if (x >= uWidth - 1 || y >= uHeight - 1) return;

    vec2 cur = newVel[idx(x, y)];
    vec2 out_ = vec2(0);

    // x-face: average with left neighbour unless at wall boundary
    /*if (x == 1)
        out_.x = cur.x;
    else
        out_.x = 0.5 * (cur.x + newVel[idx(x-1, y)].x);*/
    // y-face: average with bottom neighbour unless at wall boundary
    /*if (y == 1)
        out_.y = cur.y;
    else
        out_.y = 0.5 * (cur.y + newVel[idx(x, y-1)].y);*/

    float xBound = max(boundary[idx(x, y)], boundary[idx(x - 1, y)]);
    out_.x = xBound * cur.x + (1 - xBound) * 0.5 * (cur.x + newVel[idx(x-1, y)].x);

    float yBound = max(boundary[idx(x, y)], boundary[idx(x, y - 1)]);
    out_.y = yBound * cur.y + (1 - yBound) * 0.5 * (cur.y + newVel[idx(x, y-1)].y);

    vel[idx(x, y)] = out_;
}