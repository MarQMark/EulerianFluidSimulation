#version 430
layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) writeonly buffer BufDiv      { float div[];      };
layout(std430, binding = 1) readonly  buffer BufVel      { vec2  vel[];      };
layout(std430, binding = 2) readonly  buffer BufRho      { float rho[];      };
layout(std430, binding = 3) readonly  buffer BufBoundary { float boundary[]; };

uniform int   uWidth;
uniform int   uHeight;
uniform float uLambdaP;
uniform float uLambdaM;
uniform float uEta;

int idx(int x, int y) { return y * uWidth + x; }

void main() {
    int x = int(gl_GlobalInvocationID.x) + 1;
    int y = int(gl_GlobalInvocationID.y) + 1;
    if (x >= uWidth || y >= uHeight) return;

    const int i = idx(x, y);
    const float r = rho[i];
    div[i] = 0;
    if(r < 0.5 || boundary[i] == 1) return;

    const float dx = vel[idx(x + 1, y)].x - vel[idx(x, y)].x;
    const float dy = vel[idx(x, y + 1)].y - vel[idx(x, y)].y;
    float d = dx + dy;

    if (r > 1.f)
        d -= min(uLambdaM * (r - 1.f), uEta);
    if (r < 1.f)
        d += min(uLambdaP * (1.f - r), uEta);

    div[i] = d;
}