#version 430
layout(local_size_x = 16, local_size_y = 16) in;

struct AdvCell { uint j; float val; };

layout(std430, binding = 0)            buffer BufVel        { vec2    vel[];        };
layout(std430, binding = 1)            buffer BufVelTmp     { vec2    tmpVel[];     };
layout(std430, binding = 2)            buffer BufRho        { uint    rho[];        };
layout(std430, binding = 3)            buffer BufRhoTmp     { float   tmpRho[];     };
layout(std430, binding = 4)            buffer BufGamma      { float   gamma[];      };
layout(std430, binding = 5)            buffer BufNewGamma   { float   delRho[];     };
layout(std430, binding = 6)            buffer BufBeta       { float   beta[];       };
layout(std430, binding = 7)            buffer BufABwd       { AdvCell ABwd[];       };
layout(std430, binding = 8)            buffer BufAFwd       { AdvCell AFwd[];       };
layout(std430, binding = 9)            buffer BufCountsBwd  { uint    countsBwd[];  };
layout(std430, binding = 10)           buffer BufCountsFwd  { uint    countsFwd[];  };
layout(std430, binding = 11) writeonly buffer BufDivergence { float   divergence[]; };
layout(std430, binding = 12) readonly  buffer BufPressure   { float   pressure[];   };
layout(std430, binding = 13) readonly  buffer BufForces     { vec2    forces[];     };
layout(std430, binding = 14) readonly  buffer BufBoundary   { float   boundary[];   };

uniform uint uWidth;
uniform uint uHeight;
uint idx(uint x, uint y) { return y * uWidth + x; }

uniform float uRhoD;
uniform uint uSubsteps;

float sampleRho(vec2 pos) {
    const uint x = uint(pos.x);
    const uint y = uint(pos.y);

    uint ix1 = x;
    uint ix2 = x + 1;
    if(pos.x - float(x) < 0.5f) {
        ix1 = x - 1;
        ix2 = x;
    }
    uint iy1 = y;
    uint iy2 = y + 1;
    if(pos.y - float(y) < 0.5f) {
        iy1 = y - 1;
        iy2 = y;
    }

    ix1 = clamp(ix1, 0, uWidth  - 1);
    ix2 = clamp(ix2, 0, uWidth  - 1);
    iy1 = clamp(iy1, 0, uHeight - 1);
    iy2 = clamp(iy2, 0, uHeight - 1);

    const float v[4] = {
        rho[idx(ix1, iy1)],
        rho[idx(ix1, iy2)],
        rho[idx(ix2, iy1)],
        rho[idx(ix2, iy2)]
    };

    const float x1 = float(ix1) + 0.5f;
    const float x2 = float(ix2) + 0.5f;
    const float y1 = float(iy1) + 0.5f;
    const float y2 = float(iy2) + 0.5f;

    const float dx2x1 = x2 - x1;
    float fxy1 = ((x2 - pos.x)/dx2x1) * v[0] + ((pos.x - x1)/dx2x1) * v[2];
    float fxy2 = ((x2 - pos.x)/dx2x1) * v[1] + ((pos.x - x1)/dx2x1) * v[3];
    if(dx2x1 < 1e-9) {
        fxy1 = v[1];
        fxy2 = v[3];
    }

    const float dy2y1 = y2 - y1;
    float fxy = ((y2 - pos.y)/dy2y1) * fxy1 + ((pos.y - y1)/dy2y1) * fxy2;
    if(dy2y1 < 1e-9)
        fxy = fxy1;

    return fxy;
}

vec2 traceAlongField(vec2 pos) {
    const float stepSize = uRhoD / float(uSubsteps);

    for (int s = 0; s < uSubsteps; s++) {
    if (sampleRho(pos) >= 0.5f)
        break;

    const uint ix = max(1u, min(uint(pos.x), uWidth  - 2u));
    const uint iy = max(1u, min(uint(pos.y), uHeight - 2u));

    vec2 grad = vec2(
        rho[idx(ix+1, iy  )] - rho[idx(ix-1, iy  )],
        rho[idx(ix,   iy+1)] - rho[idx(ix,   iy-1)]
    );
    const float len = sqrt(grad.x*grad.x + grad.y*grad.y);
    if (len < 1e-6f)
        break;

    vec2 next = pos + (grad / len) * stepSize;
    next.x = clamp(next.x, 1.f, float(uWidth)  - 2.f);
    next.y = clamp(next.y, 1.f, float(uHeight) - 2.f);

    if (boundary[idx(uint(next.x), uint(next.y))] > 0.5f)
        break;
        pos = next;
    }

    return pos;
}

void atomicAddFloat(uint index, float val) {
    uint assumed;
    uint oldVal = rho[index];

    do {
        assumed = oldVal;
        float currentVal = uintBitsToFloat(assumed);
        uint newVal = floatBitsToUint(currentVal + val);
        oldVal = atomicCompSwap(rho[index], assumed, newVal);

    } while (assumed != oldVal);
}

void scatterRho(const vec2 pos, const float value) {
    const uint x0 = max(0u, min(uint(pos.x),     uint(uWidth)  - 1u));
    const uint y0 = max(0u, min(uint(pos.y),     uint(uHeight) - 1u));
    const uint x1 = max(0u, min(uint(pos.x) + 1, uint(uWidth)  - 1u));
    const uint y1 = max(0u, min(uint(pos.y) + 1, uint(uHeight) - 1u));

    const float fx = pos.x - floor(pos.x);
    const float fy = pos.y - floor(pos.y);

    float w00 = (1.f-fx) * (1.f-fy);
    float w10 =      fx  * (1.f-fy);
    float w01 = (1.f-fx) *      fy;
    float w11 =      fx  *      fy;

    if (boundary[idx(x0, y0)] > 0.5f) w00 = 0.f;
    if (boundary[idx(x1, y0)] > 0.5f) w10 = 0.f;
    if (boundary[idx(x0, y1)] > 0.5f) w01 = 0.f;
    if (boundary[idx(x1, y1)] > 0.5f) w11 = 0.f;

    const float total = w00 + w10 + w01 + w11;
    if (total < 1e-6f)
    return;
    const float inv = 1.f / total;

    atomicAddFloat(idx(x0, y0), value * w00 * inv);
    atomicAddFloat(idx(x1, y0), value * w10 * inv);
    atomicAddFloat(idx(x0, y1), value * w01 * inv);
    atomicAddFloat(idx(x1, y1), value * w11 * inv);
}

void main() {
    uint x = int(gl_GlobalInvocationID.x) + 1;
    uint y = int(gl_GlobalInvocationID.y) + 1;
    if (x >= uWidth - 1 || y >= uHeight - 1) return;

    const uint i = idx(x, y);

    const float dr = delRho[i];
    if (abs(dr) < 1e-6f) return;

    const vec2 p = traceAlongField(vec2(x, y));
    scatterRho(p, -dr);
}

