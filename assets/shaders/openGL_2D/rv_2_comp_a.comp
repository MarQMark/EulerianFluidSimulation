#version 430
layout(local_size_x = 16, local_size_y = 16) in;

struct AdvCell { uint j; float val; };

layout(std430, binding = 0)          buffer BufA        { AdvCell A[];        };
layout(std430, binding = 1)          buffer BufCount    { uint    counts[];   };
layout(std430, binding = 2) readonly buffer BufGamma    { float   gamma[];    };
layout(std430, binding = 3) readonly buffer BufVel      { vec2    vel[];      };
layout(std430, binding = 4) readonly buffer BufBoundary { float   boundary[]; };

uniform int   uWidth;
uniform int   uHeight;
uniform float uDt;
uniform int   uSubsteps;

int idx(int x, int y) { return y * uWidth + x; }
float bnd(int x, int y) { return boundary[idx(x, y)]; }

bool inWall(vec2 p) {
    if (p.x < 1.0 || p.x > float(uWidth)  - 2.0 ||
    p.y < 1.0 || p.y > float(uHeight) - 2.0)
    return true;
    return bnd(clamp(int(p.x), 0, uWidth-1),
               clamp(int(p.y), 0, uHeight-1)) > 0.5;
}

vec2 domainClamp(vec2 p) {
    return clamp(p, vec2(1.0), vec2(float(uWidth) - 2.0, float(uHeight) - 2.0));
}

float BilinearInterpolation(const vec2 pos, int low_x, int low_y, int comp) {
    float x_low_inter, x_high_inter;

    // Interpolate between y values at the lower x positions
    x_low_inter = (((low_y + 0.5 * (1 - comp)) - pos[1])
    * vel[idx(low_x, low_y)][comp])
    + ((pos[1] - (low_y - 0.5 - 0.5 * comp))
    * vel[idx(low_x, low_y + 1)][comp]);
    // Interpolate between y values at the higher x positions
    x_high_inter = (((low_y + 0.5 * (1 - comp)) - pos[1])
    * vel[idx(low_x + 1, low_y)][comp])
    + ((pos[1] - (low_y - 0.5 - 0.5 * comp))
    * vel[idx(low_x + 1, low_y + 1)][comp]);

    // Interpolate between the averaged values at the low and high x positions
    return ((low_x + 0.5 * comp - pos[0]) * x_low_inter)
    + ((pos[0] - (low_x - 0.5 - 0.5 * (1 - comp))) * x_high_inter);
}

#define EPSILON 1.0e-10
vec2 sampleVel(vec2 pos) {
    float Vx, Vy;

    // Interpolate the x component
    int low_x = int(floor(pos[0] + 1) + EPSILON);
    int low_y = int(pos[1] + 0.5 + EPSILON);
    Vx = BilinearInterpolation(pos, low_x, low_y, 0);

    // Interpolate the y component
    low_x = int(pos[0] + 0.5);
    low_y = int(floor(pos[1] + 1) + EPSILON);
    Vy = BilinearInterpolation(pos, low_x, low_y, 1);

    return vec2(Vx, Vy);
}

vec2 traceParticle(vec2 start) {
    if (inWall(start)) return start;

    float subDt = -uDt / float(uSubsteps);   // backward
    vec2  pos   = start;

    for (int s = 0; s < uSubsteps; s++) {
        vec2 k1   = sampleVel(pos);
        vec2 mid  = domainClamp(pos + k1 * (subDt * 0.5));
        vec2 k2   = sampleVel(mid);
        vec2 next = pos + k2 * subDt;

        if (inWall(next)) {
            // Binary search: find last safe position before the wall
            vec2 safe = pos;
            vec2 unsafe = next;
            vec2 h = safe;
            for (int b = 0; b < 8; b++) {
                h = (safe + unsafe) * 0.5;
                if (inWall(h)) unsafe = h;
                else              safe   = h;
            }
            return safe;
        }
        pos = next;
    }
    return pos;
}

void main() {
    int x = int(gl_GlobalInvocationID.x) + 1;
    int y = int(gl_GlobalInvocationID.y) + 1;
    if (x >= uWidth - 1 || y >= uHeight - 1) return;

    int i = idx(x, y);
    counts[i] = 0u;

    vec2 pos  = vec2(x, y);
    vec2 prev = traceParticle(pos);

    int  p0x = int(floor(prev.x));
    int  p0y = int(floor(prev.y));
    float dx0 = 1.0 - (prev.x - float(p0x));
    float dy0 = 1.0 - (prev.y - float(p0y));
    float dx1 = 1.0 - dx0;
    float dy1 = 1.0 - dy0;

    float m0 = (boundary[idx(p0x  , p0y  )] != 1.0) ? dx0*dy0 : 0.0;
    float m1 = (boundary[idx(p0x+1, p0y  )] != 1.0) ? dx1*dy0 : 0.0;
    float m2 = (boundary[idx(p0x  , p0y+1)] != 1.0) ? dx0*dy1 : 0.0;
    float m3 = (boundary[idx(p0x+1, p0y+1)] != 1.0) ? dx1*dy1 : 0.0;

    float s = m0 + m1 + m2 + m3;
    if (s < 1e-9) return;

    uint k = 0u;
    float g = gamma[i];
    if(g < 1e-5)
        g = 1.0;
    if (m0 > 0.0) { A[i * 8 + k] = AdvCell(idx(p0x,  p0y  ), m0/(s * g)); k++; }
    if (m1 > 0.0) { A[i * 8 + k] = AdvCell(idx(p0x+1,p0y  ), m1/(s * g)); k++; }
    if (m2 > 0.0) { A[i * 8 + k] = AdvCell(idx(p0x,  p0y+1), m2/(s * g)); k++; }
    if (m3 > 0.0) { A[i * 8 + k] = AdvCell(idx(p0x+1,p0y+1), m3/(s * g)); k++; }
    counts[i] = k;
}

