#version 430
layout(local_size_x = 16, local_size_y = 16) in;

struct AdvCell { uint j; float val; };

layout(std430, binding = 0) readonly  buffer BufBeta  { float   beta[];   };
layout(std430, binding = 1)           buffer BufA     { AdvCell A[];      };
layout(std430, binding = 2) readonly  buffer BufCount { uint    counts[]; };

uniform int uWidth;
uniform int uHeight;

int idx(int x, int y) { return y * uWidth + x; }

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    if (x >= uWidth || y >= uHeight) return;

    uint i = uint(idx(x, y));
    uint base = i * 8u;

    for (uint k = 0u; k < counts[i]; k++) {
        uint slot = base + k;
        float b = beta[A[slot].j];
        if (b > 1e-5) {
            A[slot].val /= b;
        }
    }
}

