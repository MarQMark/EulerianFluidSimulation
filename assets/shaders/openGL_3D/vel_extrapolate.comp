#version 430
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(std430, binding = 0) readonly  buffer BufSrcVel   { vec4  srcVel[];   };
layout(std430, binding = 1) readonly  buffer BufSrcValid { float srcValid[]; };
layout(std430, binding = 2)           buffer BufDstVel   { vec4  dstVel[];   };
layout(std430, binding = 3)           buffer BufDstValid { float dstValid[]; };
layout(std430, binding = 4) readonly  buffer BufBoundary { float boundary[]; };

uniform uint uWidth;
uniform uint uHeight;
uniform uint uDepth;
uint idx(uint x, uint y, uint z) { return z * uWidth * uHeight + y * uWidth + x; }

void samp(const uint nx, const uint ny, const uint nz, inout vec3 sum, inout float n) {
    const uint ni = idx(nx, ny, nz);
    if (srcValid[ni] > 0.5f) {
        sum += srcVel[ni].xyz;
        n++;
    }
}

void main() {
    uint x = int(gl_GlobalInvocationID.x) + 1;
    uint y = int(gl_GlobalInvocationID.y) + 1;
    uint z = int(gl_GlobalInvocationID.z) + 1;
    if (x >= uWidth - 1 || y >= uHeight - 1 || z >= uDepth - 1) return;

    const  uint i = idx(x, y, z);

    if (boundary[i] > 0.5) {
        dstVel[i] = srcVel[i];
        dstValid[i] = 0.;
        return;
    }
    if (srcValid[i] > 0.5) {
        dstVel[i] = srcVel[i];
        dstValid[i] = 1.;
        return;
    }

    vec3 sum = vec3(0.);
    float n = 0;

    samp(x-1, y, z, sum, n);
    samp(x+1, y, z, sum, n);
    samp(x, y-1, z, sum, n);
    samp(x, y+1, z, sum, n);
    samp(x, y, z-1, sum, n);
    samp(x, y, z+1, sum, n);

    if(n > 0){
        dstVel[i].xyz = sum / n;
        dstValid[i] = 1.;
    }
    else{
        dstVel[i] = srcVel[i];
        dstValid[i] = 0.;
    }
}

