#version 430
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

struct AdvCell { uint j; float val; };

layout(std430, binding = 0) readonly  buffer BufRho        { float   rho[];        };
layout(std430, binding = 1) writeonly buffer BufValid      { vec4    valid[];      };
layout(std430, binding = 2) readonly  buffer BufBoundary   { float   boundary[];   };

uniform uint uWidth;
uniform uint uHeight;
uniform uint uDepth;
uint idx(uint x, uint y, uint z) { return z * uWidth * uHeight + y * uWidth + x; }

bool is_fluid(uint cx, uint cy, uint cz){
    uint ci = idx(cx, cy, cz);
    return rho[ci] >= 0.5 && boundary[ci] < 0.5;
}

void main() {
    uint x = int(gl_GlobalInvocationID.x) + 1;
    uint y = int(gl_GlobalInvocationID.y) + 1;
    uint z = int(gl_GlobalInvocationID.z) + 1;
    if (x >= uWidth - 1 || y >= uHeight - 1 || z >= uDepth - 1) return;

    const uint i = idx(x, y, z);
    const bool self = is_fluid(x, y, z);

    valid[i] = vec4(
        (self || is_fluid(x - 1u, y, z)) ? 1.f : 0.f,
        (self || is_fluid(x, y - 1u, z)) ? 1.f : 0.f,
        (self || is_fluid(x, y, z - 1u)) ? 1.f : 0.f,
        0.
    );
}

