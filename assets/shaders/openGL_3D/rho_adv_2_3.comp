#version 430
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

struct AdvCell { uint j; float val; };

layout(std430, binding = 0)            buffer BufVel        { vec4    vel[];        };
layout(std430, binding = 1)            buffer BufVelTmp     { vec4    tmpVel[];     };
layout(std430, binding = 2)            buffer BufRho        { float   rho[];        };
layout(std430, binding = 3)            buffer BufRhoTmp     { float   tmpRho[];     };
layout(std430, binding = 4)            buffer BufGamma      { float   gamma[];      };
layout(std430, binding = 5)            buffer BufNewGamma   { float   newGamma[];   };
layout(std430, binding = 6)            buffer BufBeta       { float   beta[];       };
layout(std430, binding = 7)            buffer BufABwd       { AdvCell ABwd[];       };
layout(std430, binding = 8)            buffer BufAFwd       { AdvCell AFwd[];       };
layout(std430, binding = 9)            buffer BufCountsBwd  { uint    countsBwd[];  };
layout(std430, binding = 10)           buffer BufCountsFwd  { uint    countsFwd[];  };
layout(std430, binding = 11) writeonly buffer BufDivergence { float   divergence[]; };
layout(std430, binding = 12) readonly  buffer BufPressure   { float   pressure[];   };
layout(std430, binding = 13) readonly  buffer BufForces     { vec4    forces[];     };
layout(std430, binding = 14) readonly  buffer BufBoundary   { float   boundary[];   };

uniform uint uWidth;
uniform uint uHeight;
uniform uint uDepth;
uint idx(uint x, uint y, uint z) { return z * uWidth * uHeight + y * uWidth + x; }

uniform float uDt;
uniform int   uSubsteps;

bool inWall(vec3 p) {
    if (p.x < 1.0 || p.x > uWidth  - 2.0 ||
    p.y < 1.0 || p.y > uHeight - 2.0 ||
    p.z < 1.0 || p.z > uDepth  - 2.0 )
    return true;
    return boundary[idx(
        clamp(uint(p.x), 0u, uWidth-1u),
        clamp(uint(p.y), 0u, uHeight-1u),
        clamp(uint(p.z), 0u, uDepth-1u)
    )] > 0.5f;
}

vec3 domainClamp(vec3 p) {
    return clamp(p, vec3(1.0), vec3(float(uWidth) - 2.0, float(uHeight) - 2.0,  float(uDepth) - 2.0));
}

vec3 staggeredOffset(const int comp) {
    switch (comp) {
        case 0:  return vec3(-1.0f, -0.5f, -0.5f);
        case 1:  return vec3(-0.5f, -1.0f, -0.5f);
        case 2:
        default: return vec3(-0.5f, -0.5f, -1.0f);
    }
}
float trilinearInterpolation(const vec3 pos, const int low_x, const int low_y, const int low_z, const int comp) {
    const vec3 off = staggeredOffset(comp);

    const float x0 = low_x + off.x;
    const float y0 = low_y + off.y;
    const float z0 = low_z + off.z;

    const float tx = pos.x - x0;
    const float ty = pos.y - y0;
    const float tz = pos.z - z0;

    const float v000 = vel[idx(low_x,     low_y,     low_z    )][comp];
    const float v001 = vel[idx(low_x,     low_y,     low_z + 1)][comp];
    const float v010 = vel[idx(low_x,     low_y + 1, low_z    )][comp];
    const float v011 = vel[idx(low_x,     low_y + 1, low_z + 1)][comp];
    const float v100 = vel[idx(low_x + 1, low_y,     low_z    )][comp];
    const float v101 = vel[idx(low_x + 1, low_y,     low_z + 1)][comp];
    const float v110 = vel[idx(low_x + 1, low_y + 1, low_z    )][comp];
    const float v111 = vel[idx(low_x + 1, low_y + 1, low_z + 1)][comp];

    const float v00 = v000 * (1.0f - tz) + v001 * tz;
    const float v01 = v010 * (1.0f - tz) + v011 * tz;
    const float v10 = v100 * (1.0f - tz) + v101 * tz;
    const float v11 = v110 * (1.0f - tz) + v111 * tz;

    const float vLow  = v00 * (1.0f - ty) + v01 * ty;
    const float vHigh = v10 * (1.0f - ty) + v11 * ty;

    return vLow * (1.0f - tx) + vHigh * tx;
}

vec3 sampleVel(vec3 pos) {
    const vec3 offU = staggeredOffset(0);
    const int lx_u = int(floor(pos.x - offU.x));
    const int ly_u = int(floor(pos.y - offU.y));
    const int lz_u = int(floor(pos.z - offU.z));
    const float vx = trilinearInterpolation(pos, lx_u, ly_u, lz_u, 0);

    const vec3 offV = staggeredOffset(1);
    const int lx_v = int(floor(pos.x - offV.x));
    const int ly_v = int(floor(pos.y - offV.y));
    const int lz_v = int(floor(pos.z - offV.z));
    const float vy = trilinearInterpolation(pos, lx_v, ly_v, lz_v, 1);

    const vec3 offW = staggeredOffset(2);
    const int lx_w = int(floor(pos.x - offW.x));
    const int ly_w = int(floor(pos.y - offW.y));
    const int lz_w = int(floor(pos.z - offW.z));
    const float vz = trilinearInterpolation(pos, lx_w, ly_w, lz_w, 2);

    return vec3(vx, vy, vz);
}

vec3 traceParticle(vec3 start) {
    if (inWall(start)) return start;

    float subDt = -uDt / float(uSubsteps);   // backward
    vec3  pos   = start;

    for (int s = 0; s < uSubsteps; s++) {
        vec3 k1   = sampleVel(pos - vec3(0.5));
        vec3 mid  = domainClamp(pos + k1 * (subDt * 0.5));
        vec3 k2   = sampleVel(mid - vec3(0.5));
        vec3 next = pos + k2 * subDt;

        if (inWall(next)) {
            // Binary search: find last safe position before the wall
            vec3 safe = pos;
            vec3 unsafe = next;
            vec3 h = safe;
            for (int b = 0; b < 8; b++) {
                h = (safe + unsafe) * 0.5;
                if (inWall(h)) unsafe = h;
                else              safe   = h;
            }
            return safe;
        }
        pos = next;
    }
    return pos;
}

void main() {
    uint x = int(gl_GlobalInvocationID.x) + 1;
    uint y = int(gl_GlobalInvocationID.y) + 1;
    uint z = int(gl_GlobalInvocationID.z) + 1;
    if (x >= uWidth - 1 || y >= uHeight - 1 || z >= uDepth - 1) return;

    const uint i = idx(x, y, z);

    countsBwd[i] = 0;

    if (boundary[i] > 0.5f) return;

    const vec3 prevPos = traceParticle(vec3(x, y, z));
    const uint p0x = uint(floor(prevPos.x));
    const uint p0y = uint(floor(prevPos.y));
    const uint p0z = uint(floor(prevPos.z));

    const float dx0 = 1 - (prevPos.x - p0x);
    const float dy0 = 1 - (prevPos.y - p0y);
    const float dz0 = 1 - (prevPos.z - p0z);
    const float dx1 = 1 - (p0x + 1 - prevPos.x);
    const float dy1 = 1 - (p0y + 1 - prevPos.y);
    const float dz1 = 1 - (p0z + 1 - prevPos.z);

    const uint dest[8] = {
        idx(p0x + 0, p0y + 0, p0z + 0),
        idx(p0x + 1, p0y + 0, p0z + 0),
        idx(p0x + 0, p0y + 1, p0z + 0),
        idx(p0x + 1, p0y + 1, p0z + 0),
        idx(p0x + 0, p0y + 0, p0z + 1),
        idx(p0x + 1, p0y + 0, p0z + 1),
        idx(p0x + 0, p0y + 1, p0z + 1),
        idx(p0x + 1, p0y + 1, p0z + 1)
    };

    float m[8] = {0, 0, 0, 0, 0, 0, 0, 0};
    m[0] = dx0 * dy0 * dz0 * (1 - boundary[dest[0]]);
    m[1] = dx1 * dy0 * dz0 * (1 - boundary[dest[1]]);
    m[2] = dx0 * dy1 * dz0 * (1 - boundary[dest[2]]);
    m[3] = dx1 * dy1 * dz0 * (1 - boundary[dest[3]]);
    m[4] = dx0 * dy0 * dz1 * (1 - boundary[dest[4]]);
    m[5] = dx1 * dy0 * dz1 * (1 - boundary[dest[5]]);
    m[6] = dx0 * dy1 * dz1 * (1 - boundary[dest[6]]);
    m[7] = dx1 * dy1 * dz1 * (1 - boundary[dest[7]]);

    float sum = 0;
    for (int k = 0; k < 8; k++)
        sum += m[k];
    if (sum == 0)
        return;
    float g = newGamma[i];
    if(g < 1e-5)
        g = 1.0;

    uint k = 0u;
    for (int c = 0; c < 8; c++) {
        if (m[c] > 0.0) {
            ABwd[i * 8 + k] = AdvCell(
                dest[c],
                m[c]/(sum * g)
            );
            k++;
        }
    }

    countsBwd[i] = k;
}

