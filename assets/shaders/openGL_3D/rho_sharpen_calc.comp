#version 430
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

struct AdvCell { uint j; float val; };

layout(std430, binding = 0)            buffer BufVel        { vec4    vel[];        };
layout(std430, binding = 1)            buffer BufVelTmp     { vec4    tmpVel[];     };
layout(std430, binding = 2)            buffer BufRho        { float   rho[];        };
layout(std430, binding = 3)            buffer BufRhoTmp     { float   tmpRho[];     };
layout(std430, binding = 4)            buffer BufGamma      { float   gamma[];      };
layout(std430, binding = 5)            buffer BufNewGamma   { float   delRho[];     };
layout(std430, binding = 6)            buffer BufBeta       { float   beta[];       };
layout(std430, binding = 7)            buffer BufABwd       { AdvCell ABwd[];       };
layout(std430, binding = 8)            buffer BufAFwd       { AdvCell AFwd[];       };
layout(std430, binding = 9)            buffer BufCountsBwd  { uint    countsBwd[];  };
layout(std430, binding = 10)           buffer BufCountsFwd  { uint    countsFwd[];  };
layout(std430, binding = 11) writeonly buffer BufDivergence { float   divergence[]; };
layout(std430, binding = 12) readonly  buffer BufPressure   { float   pressure[];   };
layout(std430, binding = 13) readonly  buffer BufForces     { vec4    forces[];     };
layout(std430, binding = 14) readonly  buffer BufBoundary   { float   boundary[];   };

uniform uint uWidth;
uniform uint uHeight;
uniform uint uDepth;
uint idx(uint x, uint y, uint z) { return z * uWidth * uHeight + y * uWidth + x; }

uniform float uDt;

void main() {
    uint x = int(gl_GlobalInvocationID.x) + 1;
    uint y = int(gl_GlobalInvocationID.y) + 1;
    uint z = int(gl_GlobalInvocationID.z) + 1;
    if (x >= uWidth - 1 || y >= uHeight - 1 || z >= uDepth - 1) return;

    const uint i = idx(x, y, z);

    delRho[i] = 0.f;
    if (boundary[i] > 0.5f)
        return;

    const float rC = rho[i];
    const float rL = rho[idx(x-1, y,   z  )];
    const float rR = rho[idx(x+1, y,   z  )];
    const float rD = rho[idx(x,   y-1, z  )];
    const float rU = rho[idx(x,   y+1, z  )];
    const float rB = rho[idx(x,   y,   z-1)];
    const float rF = rho[idx(x,   y,   z+1)];

    const float dpx = -(rC - rL) * uDt;
    const float dpy = -(rC - rD) * uDt;
    const float dpz = -(rC - rB) * uDt;
    const float dmx = -(rR - rC) * uDt;
    const float dmy = -(rU - rC) * uDt;
    const float dmz = -(rF - rC) * uDt;

    const float max_inc = sqrt(
        max(
            pow(max(dpx,0.f),2.f),
            pow(min(dmx,0.f),2.f)) +
        max(
            pow(max(dpy,0.f),2.f),
            pow(min(dmy,0.f),2.f)) +
        max(
            pow(max(dpz,0.f),2.f),
            pow(min(dmz,0.f),2.f)));

    const float max_dec = sqrt(
        max(
            pow(min(dpx,0.f),2.f),
            pow(max(dmx,0.f),2.f)) +
        max(
            pow(min(dpy,0.f),2.f),
            pow(max(dmy,0.f),2.f)) +
        max(
            pow(min(dpz,0.f),2.f),
            pow(max(dmz,0.f),2.f)));

    const float maxDiff = max(max(
           max(abs(rC-rL), abs(rC-rR)),
           max(abs(rC-rD), abs(rC-rU))),
           max(abs(rC-rB), abs(rC-rF)));

    const float w = pow(rC - 0.5f, 3.f) * (1.f - min(1.f, maxDiff / 0.2f));

    float dr = (w >= 0.f) ? w * max_inc : w * max_dec;

    if (rC + dr < 0.f || rC < 1e-5f)
    dr = -rC;
    else if (rC > 0.5f)
    dr = 0.f;

    delRho[i] = dr;
}

// rho_sharpen_calc.comp