#version 430
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

struct AdvCell { uint j; float val; };

layout(std430, binding = 0)            buffer BufVel        { vec4    vel[];        };
layout(std430, binding = 1)            buffer BufVelTmp     { vec4    tmpVel[];     };
layout(std430, binding = 2)            buffer BufRho        { float   rho[];        };
layout(std430, binding = 3)            buffer BufRhoTmp     { float   tmpRho[];     };
layout(std430, binding = 4)            buffer BufGamma      { float   gamma[];      };
layout(std430, binding = 5)            buffer BufNewGamma   { float   newGamma[];   };
layout(std430, binding = 6)            buffer BufBeta       { float   beta[];       };
layout(std430, binding = 7)            buffer BufABwd       { AdvCell ABwd[];       };
layout(std430, binding = 8)            buffer BufAFwd       { AdvCell AFwd[];       };
layout(std430, binding = 9)            buffer BufCountsBwd  { uint    countsBwd[];  };
layout(std430, binding = 10)           buffer BufCountsFwd  { uint    countsFwd[];  };
layout(std430, binding = 11) writeonly buffer BufDivergence { float   divergence[]; };
layout(std430, binding = 12) readonly  buffer BufPressure   { float   pressure[];   };
layout(std430, binding = 13) readonly  buffer BufForces     { vec4    forces[];     };
layout(std430, binding = 14) readonly  buffer BufBoundary   { float   boundary[];   };

uniform uint uWidth;
uniform uint uHeight;
uniform uint uDepth;
uint idx(uint x, uint y, uint z) { return z * uWidth * uHeight + y * uWidth + x; }

uniform uint uOffset;

void main() {
    uint x = 1 + int(gl_GlobalInvocationID.x);
    uint y = 2 + (int(gl_GlobalInvocationID.y) *  2) + uOffset;
    uint z = 1 + int(gl_GlobalInvocationID.z);
    if (x >= uWidth - 1 || y >= uHeight - 1 || z >= uDepth - 1) return;

    const uint idx_j = idx(x, y - 1, z);
    const uint idx_i = idx(x, y,     z);

    if (boundary[idx_i] == 1 || boundary[idx_j] == 1)
    return;

    const float g_j = gamma[idx_j];
    const float g_i = gamma[idx_i];

    if (g_j < 1e-5f || g_i < 1e-5f || g_j == g_i)
    return;

    const float avg = (g_j + g_i) * 0.5f;
    const float r_j = rho[idx_j];
    const float r_i = rho[idx_i];
    if (g_j > g_i) {
        const float dif = r_j * (g_j - g_i) / (2.0f * g_j);
        rho[idx_j] = r_j - dif;
        rho[idx_i] = r_i + dif;
    } else {
        const float dif = r_i * (g_i - g_j) / (2.0f * g_i);
        rho[idx_i] = r_i - dif;
        rho[idx_j] = r_j + dif;
    }

    gamma[idx_j] = avg;
    gamma[idx_i] = avg;
}