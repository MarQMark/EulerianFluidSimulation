#version 430
layout(local_size_x = 256) in;

layout(std430, binding = 0) writeonly buffer BufResult { float result[]; };
layout(std430, binding = 1) readonly  buffer BufA      { float a[];      };
layout(std430, binding = 2) readonly  buffer BufB      { float b[];      };

uniform int uCount;

shared float scratch[256];

void main() {
    uint gid = gl_GlobalInvocationID.x;
    uint lid = gl_LocalInvocationID.x;
    uint group = gl_WorkGroupID.x;

    float value = 0.0;

    if (gid < uCount)
    value = a[gid] * b[gid];

    scratch[lid] = value;

    barrier();

    for (uint stride = 128; stride > 0; stride >>= 1) {
        if (lid < stride)
            scratch[lid] += scratch[lid + stride];

        barrier();
    }

    if (lid == 0)
        result[group] = scratch[0];
}