#version 430
layout(local_size_x = 256) in;

// second-stage reduction of interleaved [gamma, delta] pairs.
// Input: [ gamma_0, delta_0, gamma_1, delta_1, ... ]  (uCount pairs)
// Output: same interleaved format.
layout(std430, binding = 0) writeonly buffer BufOut { float result[]; };
layout(std430, binding = 1) readonly  buffer BufIn  { float input[];  };

uniform int uCount;  // number of pairs in input (not floats)

shared float s_gamma[256];
shared float s_delta[256];

void main() {
    uint gid   = gl_GlobalInvocationID.x;
    uint lid   = gl_LocalInvocationID.x;
    uint group = gl_WorkGroupID.x;

    s_gamma[lid] = (gid < uint(uCount)) ? input[2u * gid     ] : 0.0;
    s_delta[lid] = (gid < uint(uCount)) ? input[2u * gid + 1u] : 0.0;

    barrier();

    for (uint stride = 128u; stride > 0u; stride >>= 1u) {
        if (lid < stride) {
            s_gamma[lid] += s_gamma[lid + stride];
            s_delta[lid] += s_delta[lid + stride];
        }
        barrier();
    }

    if (lid == 0u) {
        result[2u * group     ] = s_gamma[0];
        result[2u * group + 1u] = s_delta[0];
    }
}
