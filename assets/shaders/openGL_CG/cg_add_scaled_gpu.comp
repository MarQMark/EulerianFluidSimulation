#version 430
layout(local_size_x = 256) in;

// result[i] += sign * scalars[uScalarIdx] * x[i]
//
// Replaces the CPU-uniform version (cg_add_scaled.comp) for the inner loop.
// Reads the step size (alpha) directly from the GPU scalar state buffer,
// avoiding any CPU download.
layout(std430, binding = 0) buffer          BufResult { float result[];  };
layout(std430, binding = 1) readonly buffer BufX      { float xField[];  };
layout(std430, binding = 2) readonly buffer CgScalars { float scalars[]; };

uniform int   uCount;
uniform int   uScalarIdx;   // 2 = alpha, 3 = beta
uniform float uSign;        // +1.0 or -1.0

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= uint(uCount)) return;
    result[i] += uSign * scalars[uScalarIdx] * xField[i];
}
